# Use PostgreSQL in deployed environments, e.g.:
# DATABASE_URL=postgresql+psycopg://assurley:change-me@db:5432/assurley
DATABASE_URL=sqlite:///./data/assurley.db
ADMIN_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=12
ENABLE_DOCS=true
